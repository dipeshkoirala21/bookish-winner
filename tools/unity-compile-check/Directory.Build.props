<Project>
  <!-- Shared settings for the Unity compile check (see README.md). Mirrors Unity 6.3's script compiler:
       C# 9, .NET Standard 2.1 API surface. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0618/CS0619: using an [Obsolete] Unity API is an error here (task rule: no deprecated APIs).
         CS0649: Unity suppresses "field is never assigned" for [SerializeField] fields; so do we.
         NU1701: UnityEngine.Modules ships net35/net45 reference assemblies; we reference them directly. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0618;CS0619</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS1591;NU1701</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- API audit (run.sh with the audit flag): the analyzer checks every Unity symbol we use against the Unity 6.3 API. -->
  <ItemGroup Condition="'$(UnityApiIndex)' != ''">
    <AdditionalFiles Include="$(UnityApiIndex)" />
    <Analyzer Include="$(MSBuildThisFileDirectory)audit/Analyzer/bin/Release/netstandard2.0/Ghumante.UnityApiAudit.dll" />
  </ItemGroup>
</Project>
