/* Layout of the Devanagari TextSpike screen (Screens/TextSpike.uxml). Rows: case | live | reference. */

/* Back button | ribbon | spacer of the back button's width, so the ribbon stays centred. */
.spike-topbar-spacer {
    width: var(--gh-icon-button-small);
    margin: 6px;
}

/* Bottom bar with the three toggles; wraps onto two lines on narrow portrait screens. */
.spike-toolbar {
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 0;
}

.spike-toolbar .gh-pill {
    margin: 6px;
}

/* The panel takes exactly the height left between the top and bottom bars (flex-basis 0), and the list
   scrolls inside it. With flex-basis auto its "natural" height would be all 27 rows (~3000 units), and the
   overflow would be shared out with the bars instead of being scrolled. */
.spike-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 0 var(--gh-space-3) 0 var(--gh-space-3);
    padding: var(--gh-space-2) var(--gh-space-3);
}

.spike-device-info,
.gh-root .spike-device-info {
    -unity-font-definition: url("../Fonts/Mukta-Medium.ttf");
    font-size: 22px;
    color: var(--gh-ink-soft);
    white-space: normal;
    margin: 0 0 4px 0;
}

.spike-instructions,
.gh-root .spike-instructions {
    font-size: 24px;
    color: var(--gh-ink);
    white-space: normal;
    margin: 0 0 8px 0;
}

.spike-list {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.spike-row {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    padding: 6px 0;
    border-bottom-width: 2px;
    border-color: var(--gh-cream-shade);
}

.spike-row--header {
    min-height: 40px;
    border-bottom-width: 3px;
    border-color: var(--gh-cream-edge);
}

.spike-header,
.gh-root .spike-header {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
    font-size: 24px;
    color: var(--gh-ink-soft);
    margin: 0;
}

.spike-meta {
    width: 360px;
    min-width: 200px;
    flex-shrink: 1;
    padding-right: 16px;
}

.spike-id,
.gh-root .spike-id {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
    font-size: 22px;
    color: var(--gh-ink);
    margin: 0;
}

.spike-note,
.gh-root .spike-note {
    font-size: 18px;
    color: var(--gh-ink-soft);
    white-space: normal;
    margin: 0;
}

/* Live text wraps at 660 - 2*10 - 2*4 = 632 px, the reference renderer wrap width (WRAP_WIDTH_PX in game/Tools/textspike.py). */
.spike-live,
.spike-ref-col {
    width: 660px;
    flex-shrink: 0;
    padding: 0 10px;
}

.spike-sample,
.gh-root .spike-sample {
    white-space: normal;
    color: var(--gh-ink);
    margin: 0;
    padding: 4px;
}

.spike-sample--body,
.gh-root .spike-sample--body {
    -unity-font-definition: url("../Fonts/Mukta-Regular.ttf");
    font-size: 40px;
}

.spike-sample--display,
.gh-root .spike-sample--display {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 48px;
}

.spike-ref {
    background-size: contain;
    background-repeat: no-repeat;
    background-position: left center;
}

/* "Standard" toggle: same strings through the legacy generator, to show what breaks without shaping. */
.spike--standard .spike-sample {
    -unity-text-generator: standard;
}

/* ----- Orientation (ADR-017; classes set by OrientationWatcher) ---------------------------------- */

/* Portrait (931 panel units wide on a 20:9 phone): one case per block, live text above its reference.
   The live and reference cells keep their 660 px width so both still wrap at the same 632 px. */
.orient-portrait .spike-row {
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 0;
}

.orient-portrait .spike-meta {
    width: auto;
    padding-right: 0;
}

/* Narrow windows (split screen) may squeeze the cells below 660 px; the reference then no longer wraps
   at the same width, which only matters for the paragraph case. */
.orient-portrait .spike-live,
.orient-portrait .spike-ref-col {
    max-width: 100%;
}

.orient-portrait .spike-ref-col {
    border-left-width: 4px;
    border-color: var(--gh-cream-edge);
    margin-top: 4px;
}

/* The three column headings make no sense once the columns are stacked. */
.orient-portrait .spike-row--header {
    display: none;
}

.orient-portrait .spike-panel {
    margin: 0 var(--gh-space-2);
    padding: var(--gh-space-2);
}

.orient-portrait .gh-ribbon--small .gh-ribbon__title {
    font-size: 36px;
}
