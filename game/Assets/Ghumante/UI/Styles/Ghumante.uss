/*
 * Ghumante UI style (ARCHITECTURE.md 7.9): cream panels with soft borders, ribbon headers, glossy pill
 * buttons with a darker bottom edge, round icon buttons and counter pills with a "+".
 *
 * Conventions
 *   - Design tokens are USS custom properties (--gh-*) declared on :root and on .gh-root, so a
 *     screen cloned into any panel picks them up.
 *   - Every class is prefixed gh-; BEM-style elements (gh-pill__label) and modifiers (gh-pill--cyan).
 *   - Text uses UI Toolkit's Advanced Text Generator (-unity-text-generator: advanced) because
 *     Devanagari needs OpenType shaping (ARCHITECTURE.md P3). "Enable Advanced Text Generator" must also
 *     be ticked in Project Settings > UI Toolkit; ProjectSetup does that (see UI/README.md).
 *   - Fonts are referenced as TTF files; UI Toolkit creates dynamic font assets from them, which is what
 *     the Advanced Text Generator requires (it does not support static font assets).
 *   - The default runtime theme styles .unity-button / .unity-label with pseudo-state rules such as
 *     .unity-button:hover:active. Our variants repeat the states so they win on specificity ties
 *     (this sheet is attached closer to the elements than the theme, so it wins equal-specificity ties).
 *   - Motion (UI/Motion, see UI/README.md) writes only translate / scale / rotate / opacity as inline
 *     styles, and only on the elements it animates. Inline styles beat USS, and USS transitions would
 *     smooth every frame the code writes, so: no USS transition or static value on a property that code
 *     animates on the same element (e.g. pills keep their :active translate sink because code only
 *     scales and rotates them). transform-origin is set here, never animated.
 */

:root,
.gh-root {
    /* Palette */
    --gh-cream: #FFF6E3;
    --gh-cream-shade: #F6E6C4;
    --gh-cream-edge: #E3C58F;
    --gh-ink: #5B3714;
    --gh-ink-soft: #8C6741;
    --gh-outline: #6A3D10;
    --gh-sky-top: #7FD3F7;
    --gh-sky-bottom: #D9F3FF;

    --gh-yellow: #FFCB2E;
    --gh-yellow-hover: #FFD95C;
    --gh-yellow-dark: #DB8D12;
    --gh-cyan: #35C2F1;
    --gh-cyan-hover: #62D2F6;
    --gh-cyan-dark: #1781BF;
    --gh-green: #7BD23E;
    --gh-green-hover: #97DE66;
    --gh-green-dark: #4A9620;
    --gh-white: #FFFFFF;
    --gh-white-hover: #FFFBF2;
    --gh-white-dark: #CBBEA6;
    --gh-red: #FF5B4D;
    --gh-red-hover: #FF7B6F;
    --gh-red-dark: #BE3224;

    --gh-ribbon: #E8473C;
    --gh-ribbon-dark: #A82B22;
    --gh-counter-bg: rgba(62, 36, 12, 0.55);
    --gh-gloss: rgba(255, 255, 255, 0.40);
    --gh-shadow: rgba(70, 35, 0, 0.28);

    /* Shape */
    --gh-radius-panel: 36px;
    --gh-radius-pill: 44px;
    --gh-radius-pill-small: 30px;
    --gh-pill-height: 88px;
    --gh-pill-height-small: 60px;
    --gh-pill-edge: 7px;
    --gh-icon-button: 96px;
    --gh-icon-button-small: 72px;

    /* Spacing */
    --gh-space-1: 8px;
    --gh-space-2: 16px;
    --gh-space-3: 24px;
    --gh-space-4: 32px;

    /* Type */
    --gh-font-size-small: 22px;
    --gh-font-size-body: 30px;
    --gh-font-size-button: 38px;
    --gh-font-size-button-small: 28px;
    --gh-font-size-title: 76px;
}

/* ----- Root and type ---------------------------------------------------------------------------- */

.gh-root {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-font-definition: url("../Fonts/Mukta-Regular.ttf");
    font-size: var(--gh-font-size-body);
    color: var(--gh-ink);
}

/* Theme labels and buttons set their own colour and font; re-assert ours inside a Ghumante tree. */
.gh-root .unity-label,
.gh-root .unity-button {
    -unity-font-definition: url("../Fonts/Mukta-Regular.ttf");
    color: var(--gh-ink);
}

.gh-font-display {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
}

.gh-font-display-bold {
    -unity-font-definition: url("../Fonts/Baloo2-Bold.ttf");
}

.gh-font-body {
    -unity-font-definition: url("../Fonts/Mukta-Regular.ttf");
}

.gh-font-body-bold {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
}

.gh-text-small {
    font-size: var(--gh-font-size-small);
}

.gh-text-soft {
    color: var(--gh-ink-soft);
}

/* Devanagari has tall matras and a headline; it reads better slightly smaller at the same em size. */
.gh-lang-ne .gh-pill__label {
    font-size: 34px;
}

.gh-lang-ne .gh-pill--small .gh-pill__label {
    font-size: 25px;
}

/* ----- Screen backgrounds ----------------------------------------------------------------------- */

.gh-screen {
    flex-grow: 1;
    background-color: var(--gh-sky-top);
    background-image: url("../Icons/background-himalaya.png");
    background-size: cover;
    background-position: center bottom;
}

/* Screens with a living backdrop (.gh-backdrop) draw their own layers. */
.gh-screen--layered {
    background-image: none;
}

/* ----- Panels ----------------------------------------------------------------------------------- */

.gh-panel {
    background-color: var(--gh-cream);
    border-radius: var(--gh-radius-panel);
    border-width: 4px;
    border-color: var(--gh-cream-edge);
    border-bottom-width: 9px;
    padding: var(--gh-space-4);
}

.gh-panel--inset {
    background-color: var(--gh-cream-shade);
    border-width: 2px;
    border-bottom-width: 2px;
    border-radius: 24px;
    padding: var(--gh-space-2);
}

/* ----- Ribbon header ---------------------------------------------------------------------------- */

.gh-ribbon {
    flex-direction: row;
    align-self: center;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    padding: 6px 72px 14px 72px;
    margin: 0 64px;
    background-color: var(--gh-ribbon);
    border-radius: 18px;
    border-bottom-width: 10px;
    border-color: var(--gh-ribbon-dark);
    transform-origin: 50% 0%;  /* hangs and swings from its top edge */
}

/* Folded tails behind the band, drawn as darker rounded blocks offset down and outwards. */
.gh-ribbon__tail {
    position: absolute;
    top: 30px;
    width: 96px;
    height: 100px;
    background-color: var(--gh-ribbon-dark);
    border-radius: 14px;
}

.gh-ribbon__tail--left {
    left: -64px;
    rotate: -8deg;          /* MainMenuScreen.TailRestDegrees mirrors these when it flutters the tails */
    transform-origin: 100% 0%;
}

.gh-ribbon__tail--right {
    right: -64px;
    rotate: 8deg;
    transform-origin: 0% 0%;
}

.gh-ribbon__title {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: var(--gh-font-size-title);
    color: var(--gh-white);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--gh-ribbon-dark);
    text-shadow: 0 5px 0 var(--gh-ribbon-dark);
    margin: 0;
    padding: 0 10px;
}

.gh-ribbon__separator {
    -unity-font-definition: url("../Fonts/Baloo2-Bold.ttf");
    font-size: 54px;
    color: var(--gh-yellow-dark);
    margin: 0 4px;
}

.gh-ribbon--small {
    min-height: 84px;
    padding: 4px 48px 10px 48px;
    margin: 0 40px;
}

.gh-ribbon--small .gh-ribbon__title {
    font-size: 44px;
}

.gh-ribbon--small .gh-ribbon__tail {
    top: 20px;
    height: 70px;
    width: 64px;
}

.gh-ribbon--small .gh-ribbon__tail--left {
    left: -40px;
}

.gh-ribbon--small .gh-ribbon__tail--right {
    right: -40px;
}

/* ----- Glossy pill buttons ---------------------------------------------------------------------- */

.gh-pill {
    height: var(--gh-pill-height);
    min-width: 300px;
    margin: 10px 0;
    padding: 0 44px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: var(--gh-radius-pill);
    border-width: 3px;
    border-bottom-width: var(--gh-pill-edge);
    background-color: var(--gh-yellow);
    border-color: var(--gh-yellow-dark);
    /* The :active sink is USS; squash, pop-in and wobble are code (PressFeel) around the bottom centre. */
    transform-origin: 50% 100%;
    transition-property: translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

/* Pressed: the button sinks onto its darker edge. */
.gh-pill:active,
.gh-pill:hover:active {
    translate: 0 4px;
    border-bottom-width: 3px;
}

.gh-pill:disabled {
    opacity: 0.55;
}

/* Highlight across the top half; decorative, never receives input (picking-mode="Ignore"). */
.gh-pill__gloss {
    position: absolute;
    top: 6px;
    left: 18px;
    right: 18px;
    height: 38%;
    border-radius: 30px;
    background-color: var(--gh-gloss);
}

/* A soft light band that MainMenuScreen sweeps across the pill every few seconds (translate + opacity).
   The pill gets .gh-pill--shiny (clipping) only when the sweep runs, so Low-tier devices skip the mask. */
.gh-pill__shine {
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 72px;
    background-image: url("../Icons/shine.png");
    background-size: 100% 100%;
    rotate: 18deg;
    opacity: 0;
}

.gh-pill--shiny {
    overflow: hidden;
}

.gh-pill__label,
.gh-root .gh-pill__label {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: var(--gh-font-size-button);
    color: var(--gh-white);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: var(--gh-outline);
    text-shadow: 0 3px 0 var(--gh-shadow);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.gh-pill--large {
    height: 110px;
    min-width: 420px;
    border-radius: 55px;
    border-bottom-width: 9px;
}

.gh-pill--large .gh-pill__label {
    font-size: 48px;
}

.gh-pill--small {
    height: var(--gh-pill-height-small);
    min-width: 160px;
    padding: 0 26px;
    margin: 0 6px;
    border-radius: var(--gh-radius-pill-small);
    border-bottom-width: 5px;
}

.gh-pill--small .gh-pill__gloss {
    top: 4px;
    left: 12px;
    right: 12px;
    border-radius: 20px;
}

.gh-pill--small .gh-pill__label {
    font-size: var(--gh-font-size-button-small);
}

/* Colour variants (states repeated to beat the runtime theme's .unity-button:hover:active). */
.gh-pill--yellow,
.gh-pill--yellow:focus,
.gh-pill--yellow:active,
.gh-pill--yellow:hover:active {
    background-color: var(--gh-yellow);
    border-color: var(--gh-yellow-dark);
}

.gh-pill--yellow:hover {
    background-color: var(--gh-yellow-hover);
    border-color: var(--gh-yellow-dark);
}

.gh-pill--cyan,
.gh-pill--cyan:focus,
.gh-pill--cyan:active,
.gh-pill--cyan:hover:active {
    background-color: var(--gh-cyan);
    border-color: var(--gh-cyan-dark);
}

.gh-pill--cyan:hover {
    background-color: var(--gh-cyan-hover);
    border-color: var(--gh-cyan-dark);
}

.gh-pill--green,
.gh-pill--green:focus,
.gh-pill--green:active,
.gh-pill--green:hover:active {
    background-color: var(--gh-green);
    border-color: var(--gh-green-dark);
}

.gh-pill--green:hover {
    background-color: var(--gh-green-hover);
    border-color: var(--gh-green-dark);
}

.gh-pill--red,
.gh-pill--red:focus,
.gh-pill--red:active,
.gh-pill--red:hover:active {
    background-color: var(--gh-red);
    border-color: var(--gh-red-dark);
}

.gh-pill--red:hover {
    background-color: var(--gh-red-hover);
    border-color: var(--gh-red-dark);
}

.gh-pill--white,
.gh-pill--white:focus,
.gh-pill--white:active,
.gh-pill--white:hover:active {
    background-color: var(--gh-white);
    border-color: var(--gh-white-dark);
}

.gh-pill--white:hover {
    background-color: var(--gh-white-hover);
    border-color: var(--gh-white-dark);
}

/* White pills carry dark text. */
.gh-pill--white .gh-pill__label {
    color: var(--gh-ink);
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 0 var(--gh-cream-edge);
}

/* ----- Round icon buttons ----------------------------------------------------------------------- */

.gh-icon-btn,
.gh-icon-btn:focus,
.gh-icon-btn:active,
.gh-icon-btn:hover:active {
    width: var(--gh-icon-button);
    height: var(--gh-icon-button);
    min-width: var(--gh-icon-button);
    border-radius: 48px;
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--gh-white-dark);
    background-color: var(--gh-white);
    margin: 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.gh-icon-btn:hover {
    background-color: var(--gh-white-hover);
    border-color: var(--gh-white-dark);
}

.gh-icon-btn:active,
.gh-icon-btn:hover:active {
    translate: 0 4px;
    border-bottom-width: 3px;
}

.gh-icon-btn--small,
.gh-icon-btn--small:focus,
.gh-icon-btn--small:active,
.gh-icon-btn--small:hover:active {
    width: var(--gh-icon-button-small);
    height: var(--gh-icon-button-small);
    min-width: var(--gh-icon-button-small);
    border-radius: 36px;
    border-bottom-width: 6px;
}

.gh-icon-btn__glyph {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 40px;
    color: var(--gh-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ----- Icons (PNG, generated by game/Tools/make_ui_art.py) -------------------------------------- */

.gh-icon {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}

.gh-icon--small {
    width: 44px;
    height: 44px;
}

.gh-icon--heart {
    background-image: url("../Icons/heart.png");
}

.gh-icon--star {
    background-image: url("../Icons/star.png");
}

.gh-icon--coin {
    background-image: url("../Icons/coin.png");
}

.gh-icon--energy {
    background-image: url("../Icons/energy.png");
}

.gh-icon--gear {
    background-image: url("../Icons/gear.png");
}

.gh-icon--globe {
    background-image: url("../Icons/globe.png");
}

.gh-icon--back {
    background-image: url("../Icons/back.png");
}

.gh-icon--map {
    background-image: url("../Icons/map.png");
}

/* ----- Counter pills (hearts, stars, coins, energy) --------------------------------------------- */

.gh-counters {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.gh-counter {
    flex-direction: row;
    align-items: center;
    height: 60px;
    min-width: 190px;
    margin: 8px 18px 8px 34px;
    padding: 0 6px 0 48px;
    border-radius: 30px;
    background-color: var(--gh-counter-bg);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
}

/* The icon overhangs the pill on the left, like the reference. */
.gh-counter__icon {
    position: absolute;
    left: -34px;
    top: -8px;
    width: 72px;
    height: 72px;
}

.gh-counter__value,
.gh-root .gh-counter__value {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 34px;
    color: var(--gh-white);
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--gh-outline);
    margin: 0 10px 0 0;
    padding: 0;
}

.gh-counter__plus,
.gh-counter__plus:focus,
.gh-counter__plus:active,
.gh-counter__plus:hover:active {
    width: 46px;
    height: 46px;
    min-width: 46px;
    margin: 0;
    padding: 0;
    border-radius: 23px;
    border-width: 2px;
    border-bottom-width: 4px;
    background-color: var(--gh-green);
    border-color: var(--gh-green-dark);
    align-items: center;
    justify-content: center;
}

.gh-counter__plus:hover {
    background-color: var(--gh-green-hover);
    border-color: var(--gh-green-dark);
}

.gh-counter__plus-label,
.gh-root .gh-counter__plus-label {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 36px;
    color: var(--gh-white);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--gh-green-dark);
    margin: -4px 0 0 0;
    padding: 0;
}

/* ----- Layout helpers --------------------------------------------------------------------------- */

.gh-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--gh-space-2) var(--gh-space-3);
    /* UI Toolkit defaults to flex-shrink: 1. Without this, a tall middle section (e.g. a long ScrollView)
       squeezes the bars below their content and their buttons spill off-screen. */
    flex-shrink: 0;
}

.gh-bottombar {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--gh-space-2) var(--gh-space-3);
    flex-shrink: 0; /* see .gh-topbar */
}

.gh-row {
    flex-direction: row;
    align-items: center;
}

.gh-grow {
    flex-grow: 1;
}

.gh-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.gh-subtitle,
.gh-root .gh-subtitle {
    -unity-font-definition: url("../Fonts/Baloo2-Bold.ttf");
    font-size: 40px;
    color: var(--gh-white);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: var(--gh-cyan-dark);
    margin: 22px 0 18px 0;
}

.gh-attribution,
.gh-root .gh-attribution {
    font-size: 20px;
    color: var(--gh-ink);
    background-color: rgba(255, 246, 227, 0.75);
    border-radius: 10px;
    padding: 2px 10px;
}

/* ----- Main menu -------------------------------------------------------------------------------- */

.gh-menu-panel {
    margin-top: 12px;
    min-width: 520px;
    align-items: stretch;
}

/* ----- Toast (ASSET_MANIFEST.md 12.1: slides in from the top; icon + one line) ------------------- */

/* The bubble fades with the class (USS transition on opacity); MainMenuScreen adds the slide and pop
   with translate/scale, so reduced motion keeps a plain fade. */
.gh-toast,
.gh-root .gh-toast {
    position: absolute;
    top: 15%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    max-width: 86%;
    padding: 8px 30px 8px 12px;
    border-radius: 34px;
    background-color: var(--gh-cream);
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--gh-cream-edge);
    transform-origin: 50% 0%;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.gh-toast--visible,
.gh-root .gh-toast.gh-toast--visible {
    /* Must out-rank ".gh-root .gh-toast" (opacity 0) above, or the toast never shows. */
    opacity: 1;
}

.gh-toast__icon {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.gh-toast__icon--scooter {
    background-image: url("../Icons/scooter.png");
}

.gh-toast__icon--map {
    background-image: url("../Icons/map.png");
}

.gh-toast__icon--star {
    background-image: url("../Icons/star.png");
}

.gh-toast__icon--heart {
    background-image: url("../Icons/heart.png");
}

.gh-toast__icon--energy {
    background-image: url("../Icons/energy.png");
}

.gh-toast__text,
.gh-root .gh-toast__text {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
    font-size: 30px;
    color: var(--gh-ink);
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

/* ----- Speech bubble ("Namaste!" when the title ribbon is tapped) -------------------------------- */

.gh-bubble,
.gh-root .gh-bubble {
    position: absolute;
    top: -84px;
    align-self: center;
    padding: 2px 30px 8px 30px;
    border-radius: 30px;
    background-color: var(--gh-white);
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--gh-cream-edge);
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 44px;
    color: var(--gh-ribbon);
    white-space: nowrap;
    transform-origin: 50% 100%;
    opacity: 0;
}

/* ----- Living backdrop (UI/Motion/LivingBackdrop.cs; art from game/Tools/make_ui_art.py) ----------
 * Parallax layers, back to front. Each layer overhangs the screen so the tilt parallax never shows an
 * edge; LivingBackdrop also bleeds the whole backdrop under the notch and home indicator. Layers use
 * "cover" anchored at the bottom: portrait shows a centre crop around the hero peak (ASSET_MANIFEST.md
 * 12: one composition, centre-safe crop for both orientations). Landscape shows the whole range: there
 * the hills and meadow fit the width instead (see "Orientation"), because cover on a short, wide layer
 * would clip their tops into a flat line.
 */

.gh-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.gh-layer {
    position: absolute;
    left: -48px;
    right: -48px;
    bottom: -24px;
    background-size: cover;
    background-position: center bottom;
}

.gh-layer--sky {
    top: -24px;
    left: -24px;
    right: -24px;
    background-image: url("../Icons/bg-sky.png");
    background-size: 100% 100%;
}

.gh-layer--mountains {
    height: 84%;
    background-image: url("../Icons/bg-mountains.png");
}

.gh-layer--hills {
    height: 40%;
    background-image: url("../Icons/bg-hills.png");
}

.gh-layer--front {
    height: 22%;
    background-image: url("../Icons/bg-front.png");
}

.gh-sun {
    position: absolute;
    top: 9%;
    right: 40%;
    width: 230px;
    height: 230px;
    background-image: url("../Icons/bg-sun.png");
    background-size: 100% 100%;
}

/* Clouds sit at their home position (left/top); drift and parallax are translate offsets from it. */
.gh-cloud {
    position: absolute;
    background-size: 100% 100%;
}

.gh-cloud--a {
    width: 300px;
    height: 150px;
    background-image: url("../Icons/cloud-a.png");
}

.gh-cloud--b {
    width: 200px;
    height: 110px;
    background-image: url("../Icons/cloud-b.png");
}

.gh-cloud--c {
    width: 260px;
    height: 135px;
    background-image: url("../Icons/cloud-c.png");
}

.gh-cloud--1 {
    left: 5%;
    top: 12%;
}

.gh-cloud--2 {
    left: 42%;
    top: 24%;
}

.gh-cloud--3 {
    left: 66%;
    top: 7%;
}

.gh-cloud--4 {
    left: 86%;
    top: 31%;
}

/* A small V of birds; LivingBackdrop flies the group across now and then and flaps each bird. */
.gh-birds {
    position: absolute;
    left: 0;
    top: 27%;
    width: 150px;
    height: 70px;
}

.gh-bird {
    position: absolute;
    width: 48px;
    height: 24px;
    background-image: url("../Icons/bird.png");
    background-size: 100% 100%;
}

.gh-bird--lead {
    left: 52px;
    top: 0;
}

.gh-bird--left {
    left: 6px;
    top: 24px;
    width: 40px;
    height: 20px;
}

.gh-bird--right {
    left: 102px;
    top: 28px;
    width: 42px;
    height: 21px;
}

/* Prayer flags (lungta) on a sagging string. The flags are created by LivingBackdrop on the rope's
   curve (RopeY) in the traditional order blue, white, red, green, yellow, and flutter from their top. */
.gh-flags {
    position: absolute;
    left: 0;
    right: 0;
    top: 11%;
    height: 140px;
}

.gh-flags__rope {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Icons/flag-rope.png");
    background-size: 100% 100%;
}

.gh-flag {
    position: absolute;
    width: 32px;
    height: 40px;
    margin-left: -16px;
    margin-top: -3px;
    background-image: url("../Icons/flag.png");
    background-size: 100% 100%;
    transform-origin: 50% 0%;
}

.gh-flag--blue {
    -unity-background-image-tint-color: #2D6BD2;
}

.gh-flag--white {
    -unity-background-image-tint-color: #FFFFFF;
}

.gh-flag--red {
    -unity-background-image-tint-color: #E2403A;
}

.gh-flag--green {
    -unity-background-image-tint-color: #3AA65A;
}

.gh-flag--yellow {
    -unity-background-image-tint-color: #F7C531;
}

/* ----- Particles (UI/Motion/ParticleBurst.cs: pooled, translate/rotate/scale/opacity only) -------- */

.gh-fx {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.gh-particle {
    position: absolute;
    left: -24px;
    top: -24px;
    width: 48px;
    height: 48px;
    background-size: 100% 100%;
}

.gh-particle--heart {
    background-image: url("../Icons/heart.png");
}

.gh-particle--star {
    background-image: url("../Icons/star.png");
}

.gh-particle--coin {
    background-image: url("../Icons/coin.png");
}

.gh-particle--energy {
    background-image: url("../Icons/energy.png");
}

.gh-particle--sparkle {
    background-image: url("../Icons/sparkle.png");
}

.gh-particle--puff {
    background-image: url("../Icons/puff.png");
}

/* ----- Settings sheet: bottom sheet in portrait, side panel in landscape (ARCHITECTURE.md 7.10a) ---- */

.gh-sheet-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.gh-sheet-layer--open {
    display: flex;
}

.gh-scrim,
.gh-scrim:focus,
.gh-scrim:hover,
.gh-scrim:active,
.gh-scrim:hover:active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(48, 26, 6, 0.45);
}

.gh-sheet {
    position: absolute;
    padding: var(--gh-space-3);
}

.gh-sheet__content {
    flex-grow: 1;
}

.gh-sheet__handle {
    flex-shrink: 0;
}

.gh-sheet__grabber {
    align-self: center;
    width: 96px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--gh-cream-edge);
    margin-bottom: var(--gh-space-1);
    flex-shrink: 0;
}

.gh-sheet__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--gh-space-1);
    flex-shrink: 0;
}

.gh-sheet__title,
.gh-root .gh-sheet__title {
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: 50px;
    color: var(--gh-ribbon);
    margin: 0;
    padding: 0 0 0 8px;
}

.gh-sheet__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.gh-sheet__done {
    align-self: center;
    min-width: 280px;
    margin-top: var(--gh-space-2);
    flex-shrink: 0;
}

.gh-setting {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    margin: 6px 0;
    border-radius: 24px;
    background-color: var(--gh-cream-shade);
}

.gh-setting__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--gh-space-2);
}

.gh-setting__label,
.gh-root .gh-setting__label {
    -unity-font-definition: url("../Fonts/Baloo2-Bold.ttf");
    font-size: 34px;
    color: var(--gh-ink);
    margin: 0;
    padding: 0;
}

.gh-setting__hint,
.gh-root .gh-setting__hint {
    font-size: 22px;
    color: var(--gh-ink-soft);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.gh-setting__status,
.gh-root .gh-setting__status {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
    font-size: 24px;
    color: var(--gh-cyan-dark);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.gh-setting__note,
.gh-root .gh-setting__note {
    font-size: 22px;
    color: var(--gh-ink-soft);
    white-space: normal;
    margin: 4px 20px;
}

/* Toggle (ghm_ui_toggle): pill track with a knob. The state is the --on class (USS moves the knob with
   `left`, once per switch); SettingsSheet slides and squashes the knob with translate/scale. */
.gh-toggle,
.gh-toggle:focus,
.gh-toggle:hover,
.gh-toggle:active,
.gh-toggle:hover:active {
    width: 108px;
    height: 60px;
    min-width: 108px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    border-radius: 30px;
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: var(--gh-white-dark);
    background-color: #E2D5BB;
}

.gh-toggle--on,
.gh-toggle--on:focus,
.gh-toggle--on:hover,
.gh-toggle--on:active,
.gh-toggle--on:hover:active {
    background-color: var(--gh-green);
    border-color: var(--gh-green-dark);
}

.gh-toggle__knob {
    position: absolute;
    left: 4px;
    top: 3px;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--gh-white-dark);
    background-color: var(--gh-white);
}

.gh-toggle--on .gh-toggle__knob {
    left: 50px;
}

/* Segmented choice (language). Options are 78 units tall, about 32 pt on a phone: the height of a native
   segmented control (the switches and Play take their whole row as their touch target instead). */
.gh-segment {
    flex-direction: row;
    flex-shrink: 0;
    padding: 4px;
    border-radius: 43px;
    background-color: #E2D5BB;
}

.gh-segment__option,
.gh-segment__option:focus,
.gh-segment__option:hover,
.gh-segment__option:active,
.gh-segment__option:hover:active {
    height: 78px;
    min-width: 128px;
    margin: 0;
    padding: 0 22px;
    border-width: 0;
    border-radius: 39px;
    background-color: rgba(0, 0, 0, 0);
}

.gh-root .gh-segment__option {
    -unity-font-definition: url("../Fonts/Mukta-Bold.ttf");
    font-size: 26px;
    color: var(--gh-ink);
}

.gh-segment__option--selected,
.gh-segment__option--selected:focus,
.gh-segment__option--selected:hover,
.gh-segment__option--selected:active,
.gh-segment__option--selected:hover:active {
    background-color: var(--gh-yellow);
    border-bottom-width: 4px;
    border-color: var(--gh-yellow-dark);
}

/* ----- Orientation (ARCHITECTURE.md 7.10a, ADR-017) ----------------------------------------------
 * OrientationWatcher puts .orient-portrait or .orient-landscape on every screen's .gh-root, from the
 * aspect ratio of the safe area, and updates it live when the device rotates. One UXML per screen;
 * the rules below re-flow it. Panel units: the PanelSettings scale is orientation-neutral, so a 20:9
 * phone is about 2069 x 931 units in landscape and 931 x 2069 in portrait (ProjectSetup).
 *   Landscape: classic two-sided layout, hero on the left, menu on the right.
 *   Portrait: counters along the top, hero in the upper half, primary buttons in the bottom third.
 */

.gh-hero {
    align-items: center;
}

/* Landscape */

.orient-landscape .gh-menu-body {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.orient-landscape .gh-menu-panel {
    margin-top: 0;
}

/* The hills and meadow are short layers. On a wide screen "cover" scales them to the width, which makes
   the image taller than the layer and clips its top (hill crests, bushes) into a straight line. Landscape
   fits them to the width instead (the same scale), bottom-anchored in a layer as tall as the backdrop, so
   nothing is clipped; their tops are transparent. Mountains are tall enough for cover up to about 21:9. */
.orient-landscape .gh-layer--hills,
.orient-landscape .gh-layer--front {
    top: 0;
    height: auto;
    background-size: 100% auto;
}

/* Portrait */

.orient-portrait .gh-topbar {
    flex-direction: column;
    align-items: stretch;
    padding: var(--gh-space-2) var(--gh-space-2) 0 var(--gh-space-2);
}

.orient-portrait .gh-counters {
    justify-content: center;
}

.orient-portrait .gh-counter {
    min-width: 130px;
    margin: 8px 6px 8px 30px;
}

.orient-portrait .gh-topbar__actions {
    align-self: flex-end;
}

.orient-portrait .gh-menu-body {
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: var(--gh-space-3) var(--gh-space-2) 0 var(--gh-space-2);
}

.orient-portrait .gh-hero .gh-ribbon {
    min-height: 96px;
    padding: 4px 40px 12px 40px;
    margin: 0 40px;
}

.orient-portrait .gh-hero .gh-ribbon .gh-ribbon__tail {
    top: 24px;
    width: 64px;
    height: 80px;
}

.orient-portrait .gh-hero .gh-ribbon .gh-ribbon__tail--left {
    left: -40px;
}

.orient-portrait .gh-hero .gh-ribbon .gh-ribbon__tail--right {
    right: -40px;
}

.orient-portrait .gh-hero .gh-ribbon__title {
    font-size: 56px;
}

.orient-portrait .gh-hero .gh-ribbon__separator {
    font-size: 40px;
}

/* The menu panel fills most of the width and sits at the bottom of the body, i.e. in the thumb zone. */
.orient-portrait .gh-menu-panel {
    width: 88%;
    max-width: 760px;
    min-width: 0;
    margin: 0 0 var(--gh-space-2) 0;
}

.orient-portrait .gh-pill--large {
    min-width: 0;
}

.orient-portrait .gh-bottombar {
    padding: var(--gh-space-1) var(--gh-space-2) var(--gh-space-2) var(--gh-space-2);
    flex-wrap: wrap;
}

.orient-portrait .gh-toast {
    top: 30%;
}

/* Living backdrop, portrait: a taller range (the hero peak rises behind the title), flags in the open
   sky between the title and the menu panel. */
.orient-portrait .gh-layer--mountains {
    height: 70%;
    background-image: url("../Icons/bg-mountains-portrait.png");  /* sharper centre crop */
}

.orient-portrait .gh-layer--hills {
    height: 34%;
}

.orient-portrait .gh-layer--front {
    height: 18%;
}

.orient-portrait .gh-sun {
    top: 24.5%;
    right: 6%;
    width: 190px;
    height: 190px;
}

.orient-portrait .gh-flags {
    top: 25.5%;
    height: 130px;
}

.orient-portrait .gh-birds {
    top: 36%;
}

.orient-portrait .gh-cloud--1 {
    left: 2%;
    top: 23.5%;
}

.orient-portrait .gh-cloud--2 {
    left: 62%;
    top: 33%;
}

.orient-portrait .gh-cloud--3 {
    left: 20%;
    top: 40%;
}

.orient-portrait .gh-cloud--4 {
    left: 70%;
    top: 47%;
}

/* Settings: bottom sheet in portrait, side panel on the right in landscape. The transform origin is on the
   screen edge the sheet rests on: its open overshoot stretches it from there (SettingsSheet). */
.orient-portrait .gh-sheet {
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    transform-origin: 50% 100%;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-width: 0;
}

.orient-landscape .gh-sheet {
    top: 0;
    bottom: 0;
    right: 0;
    width: 46%;
    min-width: 640px;
    transform-origin: 100% 50%;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right-width: 0;
}

.orient-landscape .gh-sheet__grabber {
    display: none;
}
