<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain .NET test project for the engine-agnostic Ghumante.Core assembly. It compiles the Core sources
    directly (no Unity, no project reference) and checks them against the golden files that
    shared/golden/make_golden.py writes with the Python pipeline (docs/DATA_FORMATS.md).
    LangVersion 9 keeps Core within what Unity 6 compiles.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Ghumante.Core.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../game/Assets/Ghumante/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="*.cs" />
    <Compile Include="Support/*.cs" />
  </ItemGroup>

  <!--
    The engine-free tile build of the World assembly (integration package): the streaming tests (Streaming*) build
    tiles exactly as the game's streamer does (TileBuild.Execute with MeshingSettings.ForTier) and drive the scheduler.
    These files must stay free of UnityEngine.
  -->
  <ItemGroup>
    <Compile Include="../game/Assets/Ghumante/World/Streaming/TileBuild.cs" LinkBase="World/Streaming" />
    <Compile Include="../game/Assets/Ghumante/World/Streaming/MeshParts.cs" LinkBase="World/Streaming" />
    <Compile Include="../game/Assets/Ghumante/World/Streaming/StreamingScheduler.cs" LinkBase="World/Streaming" />
    <Compile Include="../game/Assets/Ghumante/World/Streaming/StreamingWiring.cs" LinkBase="World/Streaming" />
    <Compile Include="../game/Assets/Ghumante/World/Streaming/TileResidency.cs" LinkBase="World/Streaming" />
    <Compile Include="../game/Assets/Ghumante/World/Instancing/TileInstances.cs" LinkBase="World/Instancing" />
    <Compile Include="../game/Assets/Ghumante/World/Instancing/ParkedPlacement.cs" LinkBase="World/Instancing" />
    <Compile Include="../game/Assets/Ghumante/World/Instancing/WorldHash.cs" LinkBase="World/Instancing" />
    <Compile Include="../game/Assets/Ghumante/World/Instancing/DressingConfig.cs" LinkBase="World/Instancing" />
    <Compile Include="../game/Assets/Ghumante/World/Buildings/BandConfig.cs" LinkBase="World/Buildings" />
    <Compile Include="../game/Assets/Ghumante/World/Sacred/HeroSet.cs" LinkBase="World/Sacred" />
    <Compile Include="../game/Assets/Ghumante/World/Sacred/HeroLodBudget.cs" LinkBase="World/Sacred" />
    <Compile Include="../game/Assets/Ghumante/World/Rendering/EarthCurvature.cs" LinkBase="World/Rendering" />
    <Compile Include="../game/Assets/Ghumante/World/Sky/SkyPalette.cs" LinkBase="World/Sky" />
    <Compile Include="../game/Assets/Ghumante/World/Life/LifeLod.cs" LinkBase="World/Life" />
    <Compile Include="../game/Assets/Ghumante/World/Life/LifeHost.cs" LinkBase="World/Life" />
    <Compile Include="../game/Assets/Ghumante/World/Life/LifeDraws.cs" LinkBase="World/Life" />
    <Compile Include="../game/Assets/Ghumante/World/Life/OfficerPosts.cs" LinkBase="World/Life" />
    <Compile Include="../game/Assets/Ghumante/World/Life/FaunaBindCache.cs" LinkBase="World/Life" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
